config_version=5

[application]

config/name="SkyDash"
run/main_scene="uid://d2si7b53a2w26"
config/quit_on_go_back=false
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.8017, 0.925686, 0.998567, 1)
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/image="uid://b33ry1ioyrrge"
config/icon="uid://c6f02dfbnlenm"

[autoload]

Global="*res://assets/scripts/global/global.gd"
DebugMenu="*res://addons/debug_menu/debug_menu.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/virtual_joystick/plugin.cfg")

